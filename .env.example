# Security Configuration
# IMPORTANT: Copy this file to .env and set your own values
# Never commit .env file to version control

# JWT Secret (REQUIRED IN PRODUCTION)
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION"

# Session Secret (REQUIRED IN PRODUCTION)
SESSION_SECRET="CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION"

# Application URL (for CORS)
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls (if using AI features).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
